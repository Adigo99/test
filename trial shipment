'========================================================================
' SUB-RUTIN PEMBANTU
' Tugas: Mengambil data, mengubah format tanggal, dan menempelkannya.
'========================================================================
Private Sub ProcessAndPasteData(ByVal sourceSheet As Worksheet, ByVal sourceRow As Long, ByVal sourceCol As String, ByVal destSheet As Worksheet, ByVal destRow As Long)
    Dim dataToPaste As Variant
    Dim colIndex As Long
    Dim i As Long
    
    ' Memecah data sumber berdasarkan titik koma
    dataToPaste = Split(sourceSheet.Cells(sourceRow, sourceCol).Value, ";")
    colIndex = 6 ' Mulai menempelkan dari kolom F
    
    ' Loop untuk setiap data yang sudah dipecah
    For i = LBound(dataToPaste) To UBound(dataToPaste)
        Dim dataString As String
        dataString = Trim(dataToPaste(i))
        
        If dataString <> "" Then
            On Error Resume Next
            Dim convertedDate As Date
            ' Ganti titik dengan spasi, lalu konversi ke tipe data Date
            convertedDate = CDate(Replace(dataString, ".", " "))
            
            If Err.Number = 0 Then ' Jika konversi berhasil
                destSheet.Cells(destRow, colIndex).Value = convertedDate
                destSheet.Cells(destRow, colIndex).NumberFormat = "dd - mmm"
            Else ' Jika gagal, tempel sebagai teks biasa
                destSheet.Cells(destRow, colIndex).Value = dataString
                Err.Clear
            End If
            On Error GoTo 0
        End If
        
        colIndex = colIndex + 1 ' Pindah ke kolom berikutnya
    Next i
End Sub

'========================================================================
' MAKRO UTAMA
' Tugas: Mengatur seluruh proses dari awal hingga akhir.
'========================================================================
Sub TrackRows()
    Application.ScreenUpdating = False
    
    Dim wb As Workbook
    Dim summarySheet As Worksheet
    Dim trackingSheet As Worksheet
    Dim newSheet As Worksheet
    Dim rowInput As String
    Dim rowNumbers As Variant
    Dim singleRow As Variant
    Dim sheetName As String
    
    Set wb = ThisWorkbook
    
    ' Periksa keberadaan sheet "Summary" dan "Tracking"
    On Error Resume Next
    Set summarySheet = wb.Sheets("Summary")
    Set trackingSheet = wb.Sheets("Tracking")
    On Error GoTo 0
    
    If summarySheet Is Nothing Then
        MsgBox "Sheet dengan nama ""Summary"" tidak ditemukan.", vbCritical, "Error"
        Exit Sub
    End If
    
    If trackingSheet Is Nothing Then
        MsgBox "Sheet template dengan nama ""Tracking"" tidak ditemukan.", vbCritical, "Error"
        Exit Sub
    End If
    
    ' 1. Minta input dari pengguna
    rowInput = InputBox("Masukkan nomor baris yang ingin di-tracking (pisahkan dengan koma, cth: 33,34,35).", "Pilih Baris")
    
    If rowInput = "" Then Exit Sub
    
    rowNumbers = Split(rowInput, ",")
    
    ' Loop melalui setiap nomor baris
    For Each singleRow In rowNumbers
        Dim currentRow As Long
        currentRow = CLng(Trim(singleRow))
        
        ' 2. Dapatkan nama untuk sheet baru dari kolom E
        sheetName = summarySheet.Cells(currentRow, "E").Value
        If sheetName = "" Then
            MsgBox "Nama sheet tidak ditemukan pada baris " & currentRow & ", kolom E. Baris ini akan dilewati.", vbExclamation
            GoTo NextRow
        End If
        
        ' Hapus sheet lama jika namanya sama
        Application.DisplayAlerts = False
        On Error Resume Next
        wb.Sheets(sheetName).Delete
        On Error GoTo 0
        Application.DisplayAlerts = True
        
        ' Salin (copy) sheet "Tracking" ke akhir workbook
        trackingSheet.Copy After:=wb.Sheets(wb.Sheets.Count)
        Set newSheet = ActiveSheet ' Sheet yang baru disalin menjadi sheet aktif
        
        ' Ganti nama sheet yang baru disalin
        newSheet.Name = sheetName
        
        ' Panggil sub-rutin untuk mengisi data
        ProcessAndPasteData summarySheet, currentRow, "AL", newSheet, 4   ' Kolom AL -> Baris 4
        ProcessAndPasteData summarySheet, currentRow, "AM", newSheet, 10  ' Kolom AM -> Baris 10
        ProcessAndPasteData summarySheet, currentRow, "AN", newSheet, 20  ' Kolom AN -> Baris 20
        ProcessAndPasteData summarySheet, currentRow, "AO", newSheet, 30  ' Kolom AO -> Baris 30
        
NextRow:
    Next singleRow
    
    Application.ScreenUpdating = True
    MsgBox "Proses tracking selesai!", vbInformation, "Selesai"
End Sub
